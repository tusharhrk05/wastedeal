{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WasteDeal: Python + SQLite",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "WasteDeal: setup environment",
      "jinja": true,
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Running on (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
